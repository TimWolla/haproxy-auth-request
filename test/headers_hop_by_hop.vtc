# SPDX-License-Identifier: MIT

varnishtest "Verify that hop-by-hop headers are not copied into the auth request."
feature ignore_unknown_macro

server s1 {
    rxreq
    txresp -status 201
} -start

server s_auth_backend {
    rxreq
    # Ordinary headers must still be copied, so that the blocklist is not
    # swallowing more than RFC 9110 section 7.6.1 requires.
    expect req.http.x-user == "admin"
    expect req.http.x-passwd == "123"
    # HAProxy forwards these to the Lua layer, so each one is a real regression
    # guard: they reach this server when the blocklist is absent.
    expect req.http.proxy-connection == "<undef>"
    expect req.http.keep-alive == "<undef>"
    expect req.http.te == "<undef>"
    expect req.http.trailer == "<undef>"
    # Whatever an older HAProxy hands to Lua, the probe must end up with
    # haproxy-lua-http's own "connection: close", which it appends only when no
    # connection header was copied. On HAProxy 3.4 that header never reaches the
    # Lua layer at all, so this assertion documents the probe rather than
    # guarding the blocklist; the blocklist entries above do the guarding.
    expect req.http.connection == "close"
    # A copied content-length would announce a body that the probe never
    # sends, which makes the auth server wait for bytes that never arrive.
    # Both this and Host were already suppressed before the blocklist existed,
    # so they are guards against a regression rather than new behaviour;
    # test/header_match.lua pins down every entry of the blocklist itself.
    expect req.http.content-length == "<undef>"
    txresp
} -start

haproxy h1 -conf {
    global
        lua-prepend-path ${testdir}/../?/http.lua
        lua-load ${testdir}/../auth-request.lua

    listen fe1
        mode http
        bind "fd@${fe1}"
        http-request lua.auth-intercept auth_backend / * * - -
        http-request deny if ! { var(txn.auth_response_successful) -m bool }
        server s1 ${s1_addr}:${s1_port}

    backend auth_backend
        mode http
        server auth_backend ${s_auth_backend_addr}:${s_auth_backend_port}
} -start

client c1 -connect ${h1_fe1_sock} {
    txreq \
        -method "POST" \
        -hdr "connection: keep-alive" \
        -hdr "proxy-connection: keep-alive" \
        -hdr "keep-alive: timeout=5, max=1000" \
        -hdr "te: trailers" \
        -hdr "trailer: expires" \
        -hdr "x-user: admin" \
        -hdr "x-passwd: 123" \
        -body "ping"
    rxresp
    expect resp.status == 201
} -run
